{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agrochemicals-cms-preview-20261015",
  "account_id": "e7c515dde995479daacd82ad79dfc3e8",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "CMS_CLOUDFLARE": "1",
    "NEXT_PRIVATE_MINIMAL_MODE": "1",
    "NEXT_PUBLIC_SERVER_URL": "https://agrochemicals-cms-preview-20261015.easondev.workers.dev",
    "CMS_SCHEMA_PUSH": "0",
    "CMS_PREVIEW": "1",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "agrochemicals-cms-preview-20261015",
      "database_id": "422392df-bc44-4a44-8a1a-796324b4cc26",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "agrochemicals-cms-preview-20261015",
    },
  ],
  "browser": { "binding": "BROWSER" },
  "services": [
    { "binding": "PDF_APP", "service": "agrochemicals-cms-preview-20261015" },
  ],
  "queues": {
    "producers": [
      {
        "binding": "PRODUCT_PDF_QUEUE",
        "queue": "agrochemicals-cms-preview-pdfs",
      },
    ],
    "consumers": [
      {
        "queue": "agrochemicals-cms-preview-pdfs",
        "max_batch_size": 1,
        "max_concurrency": 2,
        "max_retries": 4,
        "retry_delay": 60,
        "dead_letter_queue": "agrochemicals-cms-preview-pdfs-dlq",
      },
    ],
  },
  "observability": {
    "enabled": true,
  },
}
